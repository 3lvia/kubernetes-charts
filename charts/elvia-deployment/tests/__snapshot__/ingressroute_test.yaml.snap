ingressroute should include internal whitelist middleware when exposure is public-ip-filtered:
  1: |
    apiVersion: traefik.io/v1alpha1
    kind: IngressRoute
    metadata:
      name: demo-api
      namespace: core
    spec:
      routes:
        - kind: Rule
          match: Host(`core.dev-elvia.io`) && PathPrefix(`/demo-api`)
          middlewares:
            - name: demo-api-stripprefix
            - name: hsts-header
              namespace: dns
            - name: remove-metrics
              namespace: dns
            - name: demo-api-ipwhitelist-internal
              namespace: core
          services:
            - name: demo-api
              port: 80
  2: |
    apiVersion: traefik.io/v1alpha1
    kind: Middleware
    metadata:
      name: demo-api-stripprefix
      namespace: core
    spec:
      stripPrefix:
        prefixes:
          - /demo-api
  3: |
    apiVersion: traefik.io/v1alpha1
    kind: Middleware
    metadata:
      name: demo-api-ipwhitelist-internal
      namespace: core
    spec:
      ipAllowList:
        ipStrategy:
          depth: 1
        sourceRange:
          - 188.95.241.183/32
ingressroute should not include internal whitelist middleware when exposure is public:
  1: |
    apiVersion: traefik.io/v1alpha1
    kind: IngressRoute
    metadata:
      name: demo-api
      namespace: core
    spec:
      routes:
        - kind: Rule
          match: Host(`core.dev-elvia.io`) && PathPrefix(`/demo-api`)
          middlewares:
            - name: demo-api-stripprefix
