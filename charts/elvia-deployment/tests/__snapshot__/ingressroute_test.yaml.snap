              namespace: dns
            - name: remove-metrics
              namespace: dns
          services:
            - name: demo-api
              port: 80
  2: |
    apiVersion: traefik.io/v1alpha1
    kind: Middleware
    metadata:
      name: demo-api-stripprefix
      namespace: core
    spec:
      stripPrefix:
        prefixes:
          - /demo-api
