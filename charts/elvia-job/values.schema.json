{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$id": "http://example.com/example.json",
  "type": "object",
  "title": "The root schema",
  "description": "The root schema comprises the entire JSON document.",
  "default": {},
  "properties": {
    "name": {
      "$id": "#root/name",
      "type": "string"
    },
    "namespace": {
      "$id": "#root/namespace",
      "type": "string"
    },
    "environment": {
      "$id": "#root/environment",
      "type": "string"
    },
    "kind": {
      "$id": "#root/kind",
      "type": "string",
      "pattern": "^(Job|CronJob)$"
    },
    "schedule": {
      "$id": "#root/schedule",
      "type": "string"
    },
    "concurrencyPolicy": {
      "$id": "#root/concurrencyPolicy",
      "type": "string",
      "pattern": "^(Allow|Forbid|Replace)$"
    }
  },
  "examples": [
    {
      "name": "demo-job",
      "namespace": "core",
      "environment": "dev",
      "backoffLimit": 6,
      "completions": 1,
      "parallelism": 1,
      "image": {
        "repository": "containerregistryelvia.azurecr.io/core/demo-job",
        "tag": "20200921.2"
      },
      "imagePullSecret": "containerregistryelvia",
      "env": [
        {
          "name": "ASPNETCORE_URLS",
          "value": "http://+:8080"
        },
        {
          "name": "my_key_from_config_map",
          "valueFrom": {
            "configMapKeyRef": {
              "key": "my_key",
              "name": "demo-job"
            }
          }
        }
      ],
      "resources": {
        "limits": {
          "cpu": "100m",
          "memory": "128Mi"
        },
        "requests": {
          "cpu": "100m",
          "memory": "128Mi"
        }
      }
    },
    {
      "name": "demo-cronjob",
      "namespace": "core",
      "environment": "dev",
      "kind": "CronJob",
      "schedule": "0 2 * * *",
      "concurrencyPolicy": "Forbid",
      "successfulJobsHistoryLimit": 3,
      "failedJobsHistoryLimit": 1,
      "image": {
        "repository": "containerregistryelvia.azurecr.io/core/demo-cronjob",
        "tag": "20200921.2"
      },
      "imagePullSecret": "containerregistryelvia",
      "resources": {
        "limits": {
          "cpu": "100m",
          "memory": "128Mi"
        },
        "requests": {
          "cpu": "100m",
          "memory": "128Mi"
        }
      }
    }
  ]
}
